{
  "name": "endzone-empire",
  "version": "1.0.0",
  "private": true,
  "proxy": "http://localhost:5000",
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/lab": "^5.0.0-alpha.170",
    "@mui/material": "^5.16.7",
    "@supabase/supabase-js": "^2.110.7",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.28.0",
    "react-scripts": "^5.0.1",
    "redux": "^4.2.1",
    "redux-logger": "^3.0.6",
    "redux-saga": "^1.3.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "scripts": {
    "start": "node server/server.js",
    "client": "react-scripts start",
    "server": "nodemon --watch server server/server.js",
    "build": "react-scripts build",
    "lint:colors": "node scripts/check-color-literals.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "test": "react-scripts test --env=jsdom --watchAll=false",
    "test:server": "node --test server/test/**/*.test.js",
    "test:security": "playwright test --config=playwright.security.config.js",
    "test:e2e:auth-offline": "playwright test --config=playwright.e2e.config.js",
    "test:draft-autopick": "react-scripts test --env=node --watchAll=false --runInBand --runTestsByPath src/lib/draftAutopickClock.integration.test.js",
    "test:draft-grades-adp": "react-scripts test --env=node --watchAll=false --runInBand --runTestsByPath src/lib/draftGradeAdp.integration.test.ts",
    "test:trade-fairness": "react-scripts test --env=node --watchAll=false --runInBand --runTestsByPath src/lib/tradeFairnessApi.integration.test.js",
    "stress:waivers": "node scripts/stress-faab-waivers.js",
    "load:k6:snake-draft": "k6 run scripts/k6-snake-draft.js",
    "load:k6:notification-burst": "k6 run scripts/k6-notification-burst.js",
    "load:k6:admin-health": "k6 run load-tests/admin-dashboard-health.js",
    "infra:activate-k6": "node scripts/activate-k6.js",
    "test:load-pipeline": "node scripts/run-load-triage.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "axios-mock-adapter": "^2.1.0",
    "nodemon": "^3.1.9",
    "redux-mock-store": "^1.5.5",
    "supertest": "^7.2.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
