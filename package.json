    "@mui/lab": "^5.0.0-alpha.170",
    "@mui/material": "^5.16.7",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
