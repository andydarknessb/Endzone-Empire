# Copy to .env.security. The suite is hermetic and supports mock mode only.
SECURITY_BASE_URL=http://127.0.0.1:4173
SECURITY_NETWORK_MODE=mock
SECURITY_ALLOW_REMOTE_TARGET=false

# Optional pre-baked JWTs. Deterministic non-production tokens are used when
# these are empty; auth.setup.ts writes them to ignored storage-state files.
SECURITY_MANAGER_TOKEN=
SECURITY_COMMISSIONER_TOKEN=
