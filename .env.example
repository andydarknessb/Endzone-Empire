# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (either DATABASE_URL or the discrete PG* vars).
# Production requires a verified CA in DB_SSL_CA or DB_SSL_CA_PATH.
DATABASE_URL=postgresql://localhost:5432/endzone_empire
DATABASE_URL_RUNTIME=
DATABASE_URL_MIGRATIONS=
DB_SSL_CA=
DB_SSL_CA_PATH=
PGSSLMODE=
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# Secret used to sign JSON Web Tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# RapidAPI credentials for real-world NFL stats (Tank01 NFL Live In-Game Real Time Statistics)
RAPID_API_KEY=
RAPID_API_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com

# Tank01 quota budget (the plan allows ~1,000 requests per MONTH, not per day).
# Every Tank01 call is metered through server/modules/tank01Client.js against
# private.api_usage; all four have code defaults, so leaving them blank is fine.
#   TANK01_MONTHLY_BUDGET   spend target; past it only 'essential' calls run
#   TANK01_SOFT_PCT         % of budget where 'degraded' starts (news sheds,
#                           pollers double their cadence)
#   TANK01_HARD_CEILING     absolute stop for every priority
#   TANK01_BILLING_ANCHOR_DAY  day of month the RapidAPI cycle resets (1-28)
TANK01_MONTHLY_BUDGET=950
TANK01_SOFT_PCT=80
TANK01_HARD_CEILING=1000
TANK01_BILLING_ANCHOR_DAY=1

# Live NFL game clock (server/modules/liveGameEngine.js). The clock reads ESPN's
# free public scoreboard by default — zero Tank01 quota at a ~30s cadence.
#   LIVE_CLOCK_SOURCE    'espn' (default) or 'tank01' to force the paid path.
#                        ESPN failing 3 ticks in a row falls back to tank01
#                        automatically and recovers on its own.
#   ESPN_POLL_MS         cadence while a game is live on the free path
#   LIVE_FAST_POLL_MS    cadence while live on the Tank01 fallback (doubled
#                        again when quota is degraded)
#   LIVE_IDLE_CHECK_MS   between games this is a DB-only check — no API call
LIVE_CLOCK_SOURCE=espn
ESPN_POLL_MS=30000
LIVE_FAST_POLL_MS=600000
LIVE_IDLE_CHECK_MS=60000

# Scheduler ticks (5 min each) between Tank01 box-score syncs during live game
# windows — the biggest single lever on monthly spend. Doubles automatically
# while quota is degraded. 6 = every ~30 min.
SYNC_EVERY_TICKS=6

# How long one /getNFLNews response serves the dashboard widget (cached in Redis
# when REDIS_URL is set, otherwise in-process). Default 6h. The last good
# payload is also kept without expiry and served stale rather than erroring.
NEWS_CACHE_TTL_MS=21600000

# National Weather Service game-day forecasts (server/services/nwsWeather.service.js).
# The API is free, keyless and unmetered; the only thing it requires is a
# User-Agent identifying the caller, which is why this is REQUIRED rather than
# defaulted — a made-up contact string would be both dishonest and a good way to
# get blocked. Format: an app name plus a real contact, e.g.
#   NWS_USER_AGENT=EndzoneEmpire/1.0 (you@example.com)
# Leave it blank and weather is simply reported as unavailable: no request is
# made, and lineup advice is unaffected. Note that forecasts also need stadium
# coordinates in nfl_games.latitude/longitude, which no source populates yet.
NWS_USER_AGENT=

# TheSportsDB — player headshots + jersey numbers for the quick-view dialog
# (POST /api/scoring/sync-photos). "123" is the free public test key; it works
# without signup. TheSportsDB does not provide weekly fantasy stats — that's
# Tank01 above.
SPORTSDB_API_KEY=123

PORT=5000

# --- Integrations (email, Redis, Sentry, and verified DB TLS are required in production) ---

# Public URL used in emails and push notification links
APP_ORIGIN=

# Browser origins permitted to call Express and Socket.IO directly. Production:
# https://endzoneempire.gg,https://www.endzoneempire.gg
CLIENT_ORIGINS=
REDIS_URL=

# Error tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# LLM-written weekly recaps (requires `npm install @anthropic-ai/sdk`);
# falls back to a templated recap without it
ANTHROPIC_API_KEY=

# Email delivery via SMTP, e.g. smtps://user:pass@smtp.example.com.
# Production startup fails when SMTP is absent; message bodies and tokens are never logged.
SMTP_URL=
SMTP_FROM=
RUN_JOBS_IN_WEB=true
RETENTION_CHAT_DAYS=730
RETENTION_NOTIFICATION_DAYS=365
WORKER_STALE_MS=900000

# Web push — generate keys with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Platform administrators: comma-separated user ids granted the /admin
# dashboard and manual sync triggers (e.g. PLATFORM_ADMIN_IDS=1,42)
PLATFORM_ADMIN_IDS=

# Supabase Realtime (browser-side live NFL game state). Publishable/anon key
# only — CRA inlines REACT_APP_* into the built bundle, so never put a
# service-role key here.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.02
REACT_APP_ENVIRONMENT=development
REACT_APP_RELEASE=

# Express and Socket.IO public origins for a split production deployment.
# Leave blank locally so CRA's localhost:5000 proxy remains in use.
REACT_APP_API_ORIGIN=
REACT_APP_SOCKET_ORIGIN=

# Supabase Storage (server-side team avatar uploads — modules/supabaseAdmin.js).
# SUPABASE_SERVICE_ROLE_KEY bypasses Storage RLS and must stay server-only —
# never prefix it with REACT_APP_ or it will be inlined into the client bundle.
# Requires a public-read "team-avatars" bucket created in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
