# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (either DATABASE_URL or the discrete PG* vars).
# SSL is inferred from the host: off for localhost, on for remote hosts.
# Override explicitly with PGSSLMODE=disable or PGSSLMODE=require if needed.
DATABASE_URL=postgresql://localhost:5432/endzone_empire

# Secret used to sign JSON Web Tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# RapidAPI credentials for real-world NFL stats (Tank01 NFL Live In-Game Real Time Statistics)
RAPID_API_KEY=
RAPID_API_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com

# TheSportsDB — player headshots + jersey numbers for the quick-view dialog
# (POST /api/scoring/sync-photos). "123" is the free public test key; it works
# without signup. TheSportsDB does not provide weekly fantasy stats — that's
# Tank01 above.
SPORTSDB_API_KEY=123

PORT=5000

# --- Optional integrations (everything degrades gracefully when unset) ---

# Public URL used in emails and push notification links
APP_ORIGIN=

# Error tracking (requires `npm install @sentry/node`)
SENTRY_DSN=

# LLM-written weekly recaps (requires `npm install @anthropic-ai/sdk`);
# falls back to a templated recap without it
ANTHROPIC_API_KEY=

# Email digests via SMTP (requires `npm install nodemailer`), e.g.
# smtps://user:pass@smtp.example.com — links are logged to console without it
SMTP_URL=
SMTP_FROM=

# Web push (requires `npm install web-push`) — generate keys with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Platform administrators: comma-separated user ids granted the /admin
# dashboard and manual sync triggers (e.g. PLATFORM_ADMIN_IDS=1,42)
PLATFORM_ADMIN_IDS=

# Supabase Realtime (browser-side live NFL game state). Publishable/anon key
# only — CRA inlines REACT_APP_* into the built bundle, so never put a
# service-role key here.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
